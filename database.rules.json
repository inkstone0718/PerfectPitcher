{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      ".read": false,
      ".write": false,
      "$roomId": {
        ".read": "$roomId.matches(/^[A-Z0-9]{4}$/)",
        ".write": "$roomId.matches(/^[A-Z0-9]{4}$/) && (newData.val() === null || newData.hasChildren(['id', 'host', 'mode', 'maxPlayers', 'targetScore', 'status', 'players', 'currentQuestion', 'currentAnswer', 'questionStartTime', 'answers']))",
        "id": {
          ".validate": "newData.isString() && newData.val() === $roomId"
        },
        "host": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{8}$/)"
        },
        "mode": {
          ".validate": "newData.isString() && (newData.val() === 'chord' || newData.val() === 'note')"
        },
        "maxPlayers": {
          ".validate": "newData.isNumber() && (newData.val() === 2 || newData.val() === 3 || newData.val() === 4)"
        },
        "targetScore": {
          ".validate": "newData.isNumber() && (newData.val() === 500 || newData.val() === 1000 || newData.val() === 1500)"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'playing' || newData.val() === 'finished')"
        },
        "currentQuestion": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
        },
        "currentAnswer": {
          ".validate": "newData.isString() && newData.val().length <= 12 && newData.val().matches(/^[A-Za-z0-9# ]*$/)"
        },
        "questionStartTime": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "players": {
          ".validate": "newData.hasChildren()",
          "$playerId": {
            ".validate": "newData.val() === null || (newData.hasChildren(['id', 'name', 'score', 'isHost', 'ready']) && newData.child('id').val() === $playerId)",
            "id": {
              ".validate": "newData.isString() && newData.val() === $playerId && newData.val().matches(/^[a-z0-9]{8}$/)"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 12"
            },
            "score": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
            },
            "isHost": {
              ".validate": "newData.isBoolean()"
            },
            "ready": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "answers": {
          "$playerId": {
            ".validate": "newData.val() === null || (newData.hasChildren(['answer', 'time']) && $playerId.matches(/^[a-z0-9]{8}$/))",
            "answer": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 12 && newData.val().matches(/^[A-Za-z0-9# ]*$/)"
            },
            "time": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "profile": {
          ".validate": "newData.hasChildren(['uid', 'displayName', 'email', 'updatedAt']) && newData.child('uid').val() === $uid",
          "uid": {
            ".validate": "newData.isString() && newData.val() === $uid"
          },
          "displayName": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24 && newData.val().matches(/^[A-Za-z0-9_ .-]+$/)"
          },
          "email": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "$other": {
            ".validate": false
          }
        },
        "bestScores": {
          "$modeKey": {
            ".validate": "($modeKey === 'chord_basic' || $modeKey === 'chord_advanced' || $modeKey === 'note' || $modeKey === 'live_challenge') && newData.hasChildren(['uid', 'displayName', 'modeKey', 'score', 'total', 'percent', 'timeMs', 'rankScore', 'updatedAt']) && newData.child('uid').val() === $uid && newData.child('modeKey').val() === $modeKey",
            "uid": {
              ".validate": "newData.isString() && newData.val() === $uid"
            },
            "displayName": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24 && newData.val().matches(/^[A-Za-z0-9_ .-]+$/)"
            },
            "modeKey": {
              ".validate": "newData.isString() && newData.val() === $modeKey"
            },
            "score": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
            },
            "total": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 500"
            },
            "percent": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "timeMs": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3600000"
            },
            "rankScore": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200000000"
            },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "leaderboards": {
      "$modeKey": {
        ".read": "$modeKey === 'chord_basic' || $modeKey === 'chord_advanced' || $modeKey === 'note' || $modeKey === 'live_challenge'",
        ".indexOn": ["rankScore"],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && ($modeKey === 'chord_basic' || $modeKey === 'chord_advanced' || $modeKey === 'note' || $modeKey === 'live_challenge')",
          ".validate": "newData.hasChildren(['uid', 'displayName', 'modeKey', 'score', 'total', 'percent', 'timeMs', 'rankScore', 'updatedAt']) && newData.child('uid').val() === $uid && newData.child('modeKey').val() === $modeKey",
          "uid": {
            ".validate": "newData.isString() && newData.val() === $uid"
          },
          "displayName": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24 && newData.val().matches(/^[A-Za-z0-9_ .-]+$/)"
          },
          "modeKey": {
            ".validate": "newData.isString() && newData.val() === $modeKey"
          },
          "score": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
          },
          "total": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 500"
          },
          "percent": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "timeMs": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3600000"
          },
          "rankScore": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200000000"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
